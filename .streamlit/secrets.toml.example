# Copy this file to secrets.toml (git-ignored) and add your key.
ODDS_API_KEY = "your-key-here"

# Free key from https://www.balldontlie.io (value must be in quotes)
BALLDONTLIE_API_KEY = "your-key-here"

# Durable storage (optional but recommended): a free Supabase project keeps your no-bet list, results
# record and Odds API answers across app restarts. Setup steps are in the README. Use the project URL and
# the SECRET key (also called service_role). Never share it or commit it.
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "your-supabase-secret-key"

# For the AI write-ups (https://console.anthropic.com). Optional: the rest of the app works without it.
ANTHROPIC_API_KEY = "your-anthropic-key"
